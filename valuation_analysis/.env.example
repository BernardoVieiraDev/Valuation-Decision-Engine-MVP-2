# Adicione estas variáveis ao seu .env existente. Não substitua outras configurações.
# Ative um ou mais agentes preenchendo suas chaves de API.
ANTHROPIC_API_KEY=
AI_CLAUDE_MODEL=anthropic/claude-sonnet-4-6

OPENAI_API_KEY=
AI_GPT_MODEL=openai/gpt-5

MOONSHOT_API_KEY=
AI_KIMI_MODEL=moonshot/kimi-k2.5

# Tempo máximo de espera por agente (30 a 600 segundos).
PLAYBOOK_AI_TIMEOUT=180
